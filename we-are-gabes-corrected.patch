+
+/** Small WebP thumbnail used by map pins and list cards (full image stays for the story reader). */
+export function thumbOf(image: string): string {
+  return image.replace(/\.webp$/, '-thumb.webp');
+}
+
+/** Lowercase + strip Latin diacritics and Arabic harakat/tatweel so "Gabes" matches "Gabès". */
+export function normalizeSearch(value: string): string {
+  return value
+    .toLowerCase()
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f\u064B-\u0652\u0640]/g, '')
+    .replace(/[إأآ]/g, 'ا')
+    .replace(/ى/g, 'ي')
+    .replace(/ة/g, 'ه');
+}
